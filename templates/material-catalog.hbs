<section class="cc-material-shell">
  <header class="cc-material-header cc-catalog-header-clean">
    <div>
      <span class="cc-kicker">GM Tool · Crafting Libraries</span>
      <h1>Crafting Core Catalog</h1>
      <p>Build your own crafting system or install optional content packs.</p>
    </div>
    <button type="button" class="cc-secondary-action cc-catalog-validate" data-action="validate-catalog">
      <i class="fa-solid fa-shield-check"></i> Validate Catalog
    </button>
  </header>

  <nav class="cc-content-catalog-tabs cc-content-catalog-tabs-3" aria-label="Crafting Core content catalog">
    <button type="button" class="{{#if isMaterials}}active{{/if}}" data-action="catalog-tab" data-catalog-view="materials">
      <i class="fa-solid fa-boxes-stacked"></i><span>Materials</span><small>{{#if isMaterials}}{{catalogCount}}{{/if}}</small>
    </button>
    <button type="button" class="{{#if isProducts}}active{{/if}}" data-action="catalog-tab" data-catalog-view="products">
      <i class="fa-solid fa-box-open"></i><span>Products</span><small>{{#if isProducts}}{{productCount}}{{/if}}</small>
    </button>
    <button type="button" class="{{#if isContentPacks}}active{{/if}}" data-action="catalog-tab" data-catalog-view="packs">
      <i class="fa-solid fa-layer-group"></i><span>Content Packs</span><small>{{#if isContentPacks}}{{installedPackCount}} / {{totalPackCount}}{{/if}}</small>
    </button>
  </nav>

  {{#if isMaterials}}
  <div class="cc-material-layout">
    <aside class="cc-material-tools">
      <section class="cc-form-card cc-compact-card">
        <span class="cc-kicker">World Content</span>
        <h3>Materials</h3>
        <div class="cc-action-stack">
          <button type="button" class="cc-primary-action cc-wide" data-action="create-material"><i class="fa-solid fa-plus"></i> Create Material</button>
          <button type="button" class="cc-secondary-action cc-wide" data-action="open-materials" {{#unless summary.exists}}disabled{{/unless}}><i class="fa-solid fa-book-open"></i> Open Compendium</button>
        </div>
        <div class="cc-drop-zone cc-material-drop" data-drop-kind="custom-material">
          <i class="fa-solid fa-arrow-down-to-line"></i>
          <div><strong>Register Existing Item</strong><small>Drop any D&amp;D5e Item to copy it into the Materials library.</small></div>
        </div>
      </section>

      <section class="cc-form-card cc-compact-card">
        <span class="cc-kicker">Material Defaults</span>
        <h3>Value &amp; Drop Chance</h3>
        <div class="cc-economy-grid">
          <div class="cc-economy-head"><span>Rarity</span><span>GP</span><span>Chance</span></div>
          <div><strong class="cc-rarity common">Common</strong><input type="number" min="0" step="1" name="economy.common.price" value="{{economy.common.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.common.chance" value="{{economy.common.chance}}">%</span></div>
          <div><strong class="cc-rarity uncommon">Uncommon</strong><input type="number" min="0" step="1" name="economy.uncommon.price" value="{{economy.uncommon.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.uncommon.chance" value="{{economy.uncommon.chance}}">%</span></div>
          <div><strong class="cc-rarity rare">Rare</strong><input type="number" min="0" step="1" name="economy.rare.price" value="{{economy.rare.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.rare.chance" value="{{economy.rare.chance}}">%</span></div>
          <div><strong class="cc-rarity veryRare">Very Rare</strong><input type="number" min="0" step="1" name="economy.veryRare.price" value="{{economy.veryRare.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.veryRare.chance" value="{{economy.veryRare.chance}}">%</span></div>
          <div><strong class="cc-rarity legendary">Legendary</strong><input type="number" min="0" step="1" name="economy.legendary.price" value="{{economy.legendary.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.legendary.chance" value="{{economy.legendary.chance}}">%</span></div>
        </div>
        <button type="button" class="cc-secondary-action cc-wide" data-action="save-economy"><i class="fa-solid fa-floppy-disk"></i> Save Defaults</button>
      </section>
    </aside>

    <main class="cc-material-catalog">
      <div class="cc-catalog-summary">
        <div><span class="cc-kicker">Installed in this World</span><h2><span data-role="material-visible-count">{{shownCount}}</span> / {{catalogCount}} Materials</h2></div>
        <p>Only Materials that actually exist in this World are shown here. Optional Hammer content lives under Content Packs.</p>
      </div>

      {{#if catalogCount}}
      <div class="cc-material-filters">
        <input type="search" name="filter.search" value="{{filters.search}}" placeholder="Search materials...">
        <select name="filter.family">{{#each familyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select name="filter.nature"><option value="all">All Natures</option>{{#each natureOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select name="filter.rarity">{{#each rarityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </div>
      {{#each groups}}
      <details class="cc-material-group">
        <summary><span>{{label}}</span><small data-role="group-visible-count">{{count}} materials</small></summary>
        <div class="cc-material-table">
          <div class="cc-material-table-head"><span>Material</span><span>Rarity</span><span>Chance</span><span>Qty</span><span>Icon</span><span></span></div>
          {{#each materials}}
          <div class="cc-material-table-row" data-material-row="{{id}}" data-current-icon="{{selectedIcon}}" data-search="{{searchText}}">
            <span class="cc-material-name"><img src="{{selectedIcon}}" alt=""><span><strong>{{name}}</strong><small>{{sourceLabel}}</small></span></span>
            <span class="cc-rarity {{rarity}}">{{rarityLabel}}</span><span>{{chance}}%</span><span>{{quantity}}</span>
            <span class="cc-icon-curation" role="radiogroup" aria-label="Icon choices for {{name}}">
              {{#each iconCandidates}}<label class="cc-icon-choice {{#if selected}}selected{{/if}}" title="{{path}}"><input type="radio" name="material-icon-{{../id}}" value="{{path}}" data-action="choose-material-icon" data-material-id="{{../id}}" {{#if selected}}checked{{/if}}><img src="{{path}}" alt=""><small>{{index}}</small></label>{{/each}}
            </span>
            <button type="button" class="cc-icon-button" data-action="edit-material" data-material-id="{{id}}" aria-label="Edit {{name}}"><i class="fa-solid fa-pen"></i></button>
          </div>
          {{/each}}
        </div>
      </details>
      {{/each}}
      {{else}}
      <div class="cc-catalog-empty-state"><i class="fa-solid fa-box-open"></i><strong>No Materials installed</strong><p>Create your own Material, register an existing Item, or install a Content Pack.</p></div>
      {{/if}}
    </main>
  </div>

  {{else}}
  {{#if isProducts}}
  <div class="cc-material-layout cc-product-layout">
    <aside class="cc-material-tools">
      <section class="cc-form-card cc-compact-card">
        <span class="cc-kicker">World Content</span>
        <h3>Products</h3>
        <button type="button" class="cc-primary-action cc-wide" data-action="create-product"><i class="fa-solid fa-plus"></i> Create Product</button>
        <button type="button" class="cc-secondary-action cc-wide" data-action="open-products" {{#unless productPackExists}}disabled{{/unless}}><i class="fa-solid fa-book-open"></i> Open Compendium</button>
        <div class="cc-drop-zone cc-material-drop" data-drop-kind="custom-product">
          <i class="fa-solid fa-arrow-down-to-line"></i>
          <div><strong>Register Existing Item</strong><small>Drop any D&amp;D5e Item to create a stable Product fallback.</small></div>
        </div>
      </section>
      <section class="cc-form-card cc-compact-card cc-help-card">
        <span class="cc-kicker">Recipe Builder</span>
        <h3>Use Products in Recipes</h3>
        <p class="cc-note">Create or register the Product here, then choose it as the Recipe output in the normal Recipe Builder.</p>
      </section>
    </aside>

    <main class="cc-material-catalog cc-product-catalog">
      <div class="cc-catalog-summary">
        <div><span class="cc-kicker">Installed in this World</span><h2>{{productCount}} Products</h2></div>
        <p>World Products, installed Content Packs and external fallback mirrors share the same library.</p>
      </div>
      {{#if productCount}}
      {{#each productGroups}}
      <details class="cc-material-group">
        <summary><span>{{label}}</span><small>{{count}} products</small></summary>
        <div class="cc-product-table cc-product-table-simple">
          <div class="cc-product-table-head"><span>Product</span><span>Type</span><span>Source</span><span>Status</span><span></span></div>
          {{#each products}}
          <div class="cc-product-table-row" data-product-id="{{productId}}">
            <span class="cc-material-name"><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{identifier}}</small></span></span>
            <span>{{type}}</span><span>{{sourceLabel}}</span><span>{{statusLabel}}</span>
            <button type="button" class="cc-icon-button" data-action="open-product" data-item-id="{{id}}" aria-label="Open {{name}}"><i class="fa-solid fa-up-right-from-square"></i></button>
          </div>
          {{/each}}
        </div>
      </details>
      {{/each}}
      {{else}}
      <div class="cc-catalog-empty-state"><i class="fa-solid fa-box-open"></i><strong>No Products installed</strong><p>Create your own Product, register an existing Item, or install a Content Pack.</p></div>
      {{/if}}
    </main>
  </div>

  {{else}}
  <main class="cc-content-packs-view">
    <div class="cc-catalog-summary">
      <div><span class="cc-kicker">Optional Content</span><h2>{{installedPackCount}} / {{totalPackCount}} Packs Installed</h2></div>
      <button type="button" class="cc-primary-action" data-action="install-all-content" {{#if allPacksInstalled}}disabled{{/if}}><i class="fa-solid fa-download"></i> {{#if allPacksInstalled}}All Packs Installed{{else}}Install Missing Packs{{/if}}</button>
    </div>
    <div class="cc-content-pack-grid">
      {{#each contentPacks}}
      <section class="cc-content-pack-card {{#if installed}}installed{{else}}{{#if needsRestore}}needs-restore{{/if}}{{/if}}">
        <div class="cc-content-pack-icon"><i class="fa-solid {{icon}}"></i></div>
        <div class="cc-content-pack-copy">
          <div class="cc-content-pack-title"><h3>{{title}}</h3><span class="cc-pack-state">{{statusLabel}}</span></div>
          <p>{{description}}</p>
          <small>{{detail}}</small>
        </div>
        <button type="button" class="{{#if present}}cc-secondary-action{{else}}cc-primary-action{{/if}}" data-action="install-content-pack" data-pack-id="{{id}}" data-pack-title="{{title}}" data-installed="{{present}}" {{#unless canInstall}}disabled{{/unless}}>
          <i class="fa-solid {{actionIcon}}"></i> {{actionLabel}}
        </button>
      </section>
      {{/each}}
    </div>
    <div class="cc-pack-next-step"><i class="fa-solid fa-paw"></i><div><strong>Harvest setup is deliberate</strong><p>After installing Materials, run <strong>Creature Scanner</strong> from the main Crafting Core window when you want to build or refresh bestiary Harvest links. Gathering uses the Materials and biome data that actually exist in this World.</p></div></div>
  </main>
  {{/if}}
  {{/if}}
</section>
