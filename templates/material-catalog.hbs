<section class="cc-material-shell">
  <header class="cc-material-header">
    <div>
      <span class="cc-kicker">GM Tool</span>
      <h1>Material Catalog</h1>
      <p>Manage the Trade Goods used by Crafting Core generation systems.</p>
    </div>
    <div class="cc-material-status {{#if summary.exists}}ready{{/if}}">
      <i class="fa-solid {{#if summary.exists}}fa-circle-check{{else}}fa-circle-exclamation{{/if}}"></i>
      <div>
        <strong>{{#if summary.exists}}Materials Compendium ready{{else}}Materials Compendium not created{{/if}}</strong>
        <small>{{summary.count}} Items · {{summary.managed}} managed · {{summary.custom}} custom</small>
      </div>
    </div>
  </header>

  <div class="cc-material-layout">
    <aside class="cc-material-tools">
      <section class="cc-form-card">
        <span class="cc-kicker">Compendium</span>
        <h3>Crafting Core — Materials</h3>
        <p class="cc-note">Create or synchronize the world Compendium. Existing GM presentation edits such as names, images, descriptions, and weight are preserved.</p>
        <button type="button" class="cc-primary-action cc-wide" data-action="sync-materials"><i class="fa-solid fa-arrows-rotate"></i> Create / Sync Materials</button>
        <button type="button" class="cc-secondary-action cc-wide" data-action="open-materials"><i class="fa-solid fa-book-open"></i> Open Compendium</button>
      </section>

      <section class="cc-form-card">
        <span class="cc-kicker">Rarity Defaults</span>
        <h3>Value & Drop Chance</h3>
        <p class="cc-note">These are catalog defaults. Future Harvest Profiles can override individual chances.</p>
        <div class="cc-economy-grid">
          <div class="cc-economy-head"><span>Rarity</span><span>GP</span><span>Chance</span></div>
          <div><strong>Common</strong><input type="number" min="0" step="1" name="economy.common.price" value="{{economy.common.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.common.chance" value="{{economy.common.chance}}">%</span></div>
          <div><strong>Rare</strong><input type="number" min="0" step="1" name="economy.rare.price" value="{{economy.rare.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.rare.chance" value="{{economy.rare.chance}}">%</span></div>
          <div><strong>Legendary</strong><input type="number" min="0" step="1" name="economy.legendary.price" value="{{economy.legendary.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.legendary.chance" value="{{economy.legendary.chance}}">%</span></div>
        </div>
        <button type="button" class="cc-secondary-action cc-wide" data-action="save-economy"><i class="fa-solid fa-floppy-disk"></i> Save Defaults</button>
      </section>

      <section class="cc-form-card">
        <span class="cc-kicker">Custom Material</span>
        <h3>Register Existing Item</h3>
        <div class="cc-drop-zone cc-material-drop" data-drop-kind="custom-material">
          <i class="fa-solid fa-arrow-down-to-line"></i>
          <div><strong>Drop any D&D5e Item here</strong><small>It is copied into the Materials Compendium as Loot → Trade Good.</small></div>
        </div>
      </section>
    </aside>

    <main class="cc-material-catalog">
      <div class="cc-catalog-summary">
        <div><span class="cc-kicker">Built-in Catalog</span><h2>{{catalogCount}} Materials</h2></div>
        <p>Creature Harvest, environmental Gathering, and Profession / Trade materials share one managed source.</p>
      </div>

      {{#each groups}}
      <details class="cc-material-group" open>
        <summary><span>{{label}}</span><small>{{count}} materials</small></summary>
        <div class="cc-material-table">
          <div class="cc-material-table-head"><span>Material</span><span>Nature</span><span>Rarity</span><span>Chance</span><span>Qty</span></div>
          {{#each materials}}
          <div class="cc-material-table-row">
            <span class="cc-material-name"><img src="{{img}}" alt=""><strong>{{name}}</strong></span>
            <span>{{nature}}</span>
            <span class="cc-rarity {{rarity}}">{{rarity}}</span>
            <span>{{chance}}%</span>
            <span>{{quantity}}</span>
          </div>
          {{/each}}
        </div>
      </details>
      {{/each}}
    </main>
  </div>
</section>
