<section class="cc-material-shell">
  <header class="cc-material-header">
    <div>
      <span class="cc-kicker">GM Tool · Private Libraries</span>
      <h1>Crafting Core Catalog</h1>
      <p>Manage the 230 canonical Materials and 58 official Curated Products that can also be used as ingredients in any Recipe.</p>
    </div>
    {{#if isMaterials}}
    <div class="cc-material-status {{#if summary.exists}}ready{{/if}}">
      <i class="fa-solid {{#if summary.exists}}fa-lock{{else}}fa-circle-exclamation{{/if}}"></i>
      <div>
        <strong>{{#if summary.exists}}GM-only Materials Compendium ready{{else}}Materials Compendium not created{{/if}}</strong>
        <small>{{summary.count}} Items · {{summary.managed}} curated · {{summary.custom}} custom</small>
      </div>
    </div>
    {{else}}
    <div class="cc-material-status {{#if culinary.packExists}}ready{{/if}}">
      <i class="fa-solid {{#if culinary.packExists}}fa-utensils{{else}}fa-circle-exclamation{{/if}}"></i>
      <div>
        <strong>{{#if culinary.packExists}}Curated Products Compendium ready{{else}}Curated Products not installed{{/if}}</strong>
        <small>{{culinary.count}} / {{culinary.total}} Curated Products</small>
      </div>
    </div>
    {{/if}}
  </header>

  <nav class="cc-content-catalog-tabs" aria-label="Crafting Core content catalog">
    <button type="button" class="{{#if isMaterials}}active{{/if}}" data-action="catalog-tab" data-catalog-view="materials">
      <i class="fa-solid fa-boxes-stacked"></i><span>Materials</span><small>{{catalogCount}}</small>
    </button>
    <button type="button" class="{{#if isProducts}}active{{/if}}" data-action="catalog-tab" data-catalog-view="products">
      <i class="fa-solid fa-utensils"></i><span>Curated Products</span><small>{{culinary.total}}</small>
    </button>
  </nav>

  {{#if isMaterials}}
  <div class="cc-material-layout">
    <aside class="cc-material-tools">
      <section class="cc-form-card">
        <span class="cc-kicker">Private Compendium</span>
        <h3>Crafting Core — Materials</h3>
        <p class="cc-note">Stored under the <strong>Crafting Core</strong> Compendium folder. The pack is private and inaccessible to players.</p>
        <p class="cc-note"><i class="fa-solid fa-image"></i> Curated artwork uses Foundry Core <code>icons/...</code> references only. No Core artwork is bundled with Crafting Core.</p>
        <button type="button" class="cc-primary-action cc-wide" data-action="sync-materials"><i class="fa-solid fa-arrows-rotate"></i> Sync Catalog</button>
        <button type="button" class="cc-secondary-action cc-wide" data-action="open-materials"><i class="fa-solid fa-book-open"></i> Open Compendium</button>
        <button type="button" class="cc-secondary-action cc-wide cc-danger-soft" data-action="reset-curated-defaults"><i class="fa-solid fa-rotate-left"></i> Reset to Curated Defaults</button>
      </section>

      <section class="cc-form-card">
        <span class="cc-kicker">Rarity Defaults</span>
        <h3>Value & Drop Chance</h3>
        <p class="cc-note">Defaults for curated materials. Individual material edits override these values.</p>
        <div class="cc-economy-grid">
          <div class="cc-economy-head"><span>Rarity</span><span>GP</span><span>Chance</span></div>
          <div><strong class="cc-rarity common">Common</strong><input type="number" min="0" step="1" name="economy.common.price" value="{{economy.common.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.common.chance" value="{{economy.common.chance}}">%</span></div>
          <div><strong class="cc-rarity uncommon">Uncommon</strong><input type="number" min="0" step="1" name="economy.uncommon.price" value="{{economy.uncommon.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.uncommon.chance" value="{{economy.uncommon.chance}}">%</span></div>
          <div><strong class="cc-rarity rare">Rare</strong><input type="number" min="0" step="1" name="economy.rare.price" value="{{economy.rare.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.rare.chance" value="{{economy.rare.chance}}">%</span></div>
          <div><strong class="cc-rarity veryRare">Very Rare</strong><input type="number" min="0" step="1" name="economy.veryRare.price" value="{{economy.veryRare.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.veryRare.chance" value="{{economy.veryRare.chance}}">%</span></div>
          <div><strong class="cc-rarity legendary">Legendary</strong><input type="number" min="0" step="1" name="economy.legendary.price" value="{{economy.legendary.price}}"><span><input type="number" min="0" max="100" step="0.1" name="economy.legendary.chance" value="{{economy.legendary.chance}}">%</span></div>
        </div>
        <button type="button" class="cc-secondary-action cc-wide" data-action="save-economy"><i class="fa-solid fa-floppy-disk"></i> Save Defaults</button>
      </section>

      <section class="cc-form-card">
        <span class="cc-kicker">Custom Material</span>
        <h3>Register Existing Item</h3>
        <div class="cc-drop-zone cc-material-drop" data-drop-kind="custom-material">
          <i class="fa-solid fa-arrow-down-to-line"></i>
          <div><strong>Drop any D&D5e Item here</strong><small>It is copied into the private Materials Compendium as Loot → Trade Good and can then participate in future generation systems.</small></div>
        </div>
      </section>
    </aside>

    <main class="cc-material-catalog">
      <div class="cc-catalog-summary">
        <div><span class="cc-kicker">Built-in + Custom Catalog</span><h2><span data-role="material-visible-count">{{shownCount}}</span> / {{catalogCount}} Materials</h2></div>
        <p>Creature Harvest, Essences, Gathering, and Profession / Trade materials are organized into folders. Each curated material offers three Foundry Core icon candidates; one is preselected and can be changed here.</p>
      </div>

      <div class="cc-material-filters">
        <input type="search" name="filter.search" value="{{filters.search}}" placeholder="Search materials...">
        <select name="filter.family">{{#each familyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select name="filter.nature"><option value="all">All Natures</option>{{#each natureOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select name="filter.rarity">{{#each rarityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </div>

      {{#each groups}}
      <details class="cc-material-group" open>
        <summary><span>{{label}}</span><small data-role="group-visible-count">{{count}} materials</small></summary>
        <div class="cc-material-table">
          <div class="cc-material-table-head"><span>Material</span><span>Rarity</span><span>Chance</span><span>Qty</span><span>Core Icon — choose 1 of 3</span><span></span></div>
          {{#each materials}}
          <div class="cc-material-table-row" data-material-row="{{id}}" data-current-icon="{{selectedIcon}}" data-search="{{searchText}}">
            <span class="cc-material-name"><img src="{{selectedIcon}}" alt=""><strong>{{name}}</strong></span>
            <span class="cc-rarity {{rarity}}">{{rarityLabel}}</span>
            <span>{{chance}}%</span>
            <span>{{quantity}}</span>
            <span class="cc-icon-curation" role="radiogroup" aria-label="Core icon choices for {{name}}">
              {{#each iconCandidates}}
              <label class="cc-icon-choice {{#if selected}}selected{{/if}}" title="{{path}}">
                <input type="radio" name="material-icon-{{../id}}" value="{{path}}" data-action="choose-material-icon" data-material-id="{{../id}}" {{#if selected}}checked{{/if}}>
                <img src="{{path}}" alt="Icon option {{index}} for {{../name}}">
                <small>{{index}}</small>
              </label>
              {{/each}}
            </span>
            <button type="button" class="cc-icon-button" data-action="edit-material" data-material-id="{{id}}" aria-label="Edit {{name}}"><i class="fa-solid fa-pen"></i></button>
          </div>
          {{/each}}
        </div>
      </details>
      {{else}}
      <div class="cc-empty-row">No materials match the current filters.</div>
      {{/each}}
    </main>
  </div>
  {{else}}
  <div class="cc-material-layout cc-product-layout">
    <aside class="cc-material-tools">
      <section class="cc-form-card">
        <span class="cc-kicker">Official Product Library</span>
        <h3>Crafting Core — Products</h3>
        <p class="cc-note">The 58 official Curated Products include Meals, Alcoholic Drinks, and Non-Alcoholic Drinks. They are normal D&D5e consumables that can be sold, looted, supplied to vendors, or used as ingredients in another Recipe.</p>
        <p class="cc-note"><strong>Canonical economy:</strong> each Recipe produces a batch of servings. The total batch value targets roughly 2× ingredient cost while each Product remains priced and sold per individual serving.</p>
        <button type="button" class="cc-primary-action cc-wide" data-action="restore-curated-culinary" {{#unless culinary.compatible}}disabled{{/unless}}><i class="fa-solid fa-utensils"></i> Restore Curated Product Defaults</button>
        <button type="button" class="cc-secondary-action cc-wide" data-action="open-products" {{#unless culinary.packExists}}disabled{{/unless}}><i class="fa-solid fa-book-open"></i> Open Products Compendium</button>
      </section>

      <section class="cc-form-card">
        <span class="cc-kicker">Runtime Integration</span>
        <h3>DnD 5e Item Creator</h3>
        {{#if culinary.compatible}}
        <p class="cc-note"><i class="fa-solid fa-circle-check"></i> Active and compatible ({{culinary.itemCreatorVersion}}). Food and Alcohol persistent effects use Item Creator. They last up to 6 hours and Crafting Core also clears them on Short or Long Rest.</p>
        {{else}}
        <p class="cc-note"><i class="fa-solid fa-triangle-exclamation"></i> Persistent Curated Food and Alcohol content requires active DnD 5e Item Creator {{culinary.requiredVersion}} or newer. Core Crafting Core features remain independent.</p>
        {{/if}}
      </section>

      <section class="cc-form-card">
        <span class="cc-kicker">Published Knowledge</span>
        <h3>Recipe Learn Sources</h3>
        <p class="cc-note">Restore also repairs all 58 official <strong>Recipe</strong> sources under Learn Sources → Crafting Core Curated, separated into Culinary Meals, Alcoholic Drinks, and Non-Alcoholic Drinks with their cultural subfolders.</p>
        <p class="cc-note">The Recipe source always uses the canonical Recipe document icon; the artwork chosen here belongs to the final Product sold or distributed by vendors.</p>
      </section>
    </aside>

    <main class="cc-material-catalog cc-product-catalog">
      <div class="cc-catalog-summary">
        <div><span class="cc-kicker">Official Curated Content</span><h2>{{culinary.count}} / {{culinary.total}} Curated Products</h2></div>
        <p>Each Product has three Foundry Core icon candidates. Choosing one updates the Product and re-synchronizes the official Recipe output while preserving unrelated GM customizations. Products remain unit-priced even when their Recipe crafts multiple servings.</p>
      </div>

      {{#unless culinary.compatible}}
      <div class="cc-curated-unavailable"><i class="fa-solid fa-puzzle-piece"></i><strong>Item Creator integration required</strong><p>Activate DnD 5e Item Creator {{culinary.requiredVersion}} or newer to install or repair this official library.</p></div>
      {{else}}
      {{#each culinary.sections}}
      <section class="cc-curated-product-section">
        <div class="cc-curated-product-section-title"><strong>{{label}}</strong><small>{{count}} products</small></div>
        {{#each groups}}
        <details class="cc-material-group" open>
          <summary><span>{{label}}</span><small>{{count}} products</small></summary>
          <div class="cc-product-table">
            <div class="cc-product-table-head"><span>Product</span><span>Benefit</span><span>Yield</span><span>Ingredient Cost</span><span>Unit Price</span><span>Core Icon — choose 1 of 3</span></div>
            {{#each products}}
            <div class="cc-product-table-row" data-product-id="{{productId}}" data-current-icon="{{selectedIcon}}">
              <span class="cc-material-name"><img src="{{selectedIcon}}" alt=""><span><strong>{{name}}</strong><small>{{#if exists}}Published Product{{else}}Missing — restore defaults{{/if}}</small></span></span>
              <span class="cc-product-benefit">{{benefitLabel}}</span>
              <span>{{yieldLabel}}</span>
              <span>{{ingredientCostLabel}}</span>
              <span><strong>{{priceLabel}}</strong></span>
              <span class="cc-icon-curation" role="radiogroup" aria-label="Core icon choices for {{name}}">
                {{#each iconCandidates}}
                <label class="cc-icon-choice {{#if selected}}selected{{/if}}" title="{{path}}">
                  <input type="radio" name="product-icon-{{../id}}" value="{{path}}" data-action="choose-product-icon" data-product-id="{{../productId}}" {{#if selected}}checked{{/if}} {{#unless ../exists}}disabled{{/unless}}>
                  <img src="{{path}}" alt="Icon option {{index}} for {{../name}}">
                  <small>{{index}}</small>
                </label>
                {{/each}}
              </span>
            </div>
            {{/each}}
          </div>
        </details>
        {{/each}}
      </section>
      {{/each}}
      {{/unless}}
    </main>
  </div>
  {{/if}}
</section>
