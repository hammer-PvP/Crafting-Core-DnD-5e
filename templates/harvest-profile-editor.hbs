<section class="cc-profile-editor-shell">
  <header class="cc-profile-editor-header">
    <img src="{{profile.img}}" alt="">
    <div>
      <span class="cc-kicker">Harvest Profile</span>
      <h2>{{profile.name}}</h2>
      <p>{{profile.creatureTypeLabel}}{{#if profile.subtype}} · {{profile.subtype}}{{/if}} · CR {{profile.cr}} · {{profile.sourcePackLabel}}</p>
    </div>
    <button type="button" data-action="reanalyze-profile"><i class="fa-solid fa-wand-magic-sparkles"></i> Reanalyze</button>
  </header>

  <div class="cc-profile-editor-body">
    <section class="cc-form-card cc-analysis-card">
      <div class="cc-card-heading"><div><span class="cc-kicker">Actor Analyzer</span><h3>Inferred Anatomy</h3></div><small>Last analyzed: {{analyzedAt}}</small></div>
      <div class="cc-anatomy-tags">
        {{#each anatomy}}<span>{{label}}</span>{{else}}<span class="muted">No anatomy tags detected</span>{{/each}}
      </div>
      <label class="cc-anatomy-edit"><span>Anatomy Tags (comma separated)</span><input type="text" name="analysis.anatomy" value="{{anatomyText}}" placeholder="bone, flesh, claw, feather…"></label>
      <details>
        <summary>Why these tags?</summary>
        <ul>{{#each reasons}}<li>{{this}}</li>{{else}}<li>No additional inference notes.</li>{{/each}}</ul>
      </details>
    </section>

    <section class="cc-form-card">
      <div class="cc-card-heading"><div><span class="cc-kicker">Automatic Harvest</span><h3>Rarity Pools</h3></div><small>Each successful pool rolls exactly one selected material. More candidates add variety, not extra drops.</small></div>
      <div class="cc-profile-pool-list">
        {{#each profile.slots}}
        <div class="cc-profile-pool" data-slot-index="{{@index}}">
          <div class="cc-pool-head">
            <div class="cc-slot-label"><strong>{{label}}</strong><small><span data-pool-count>{{selectedCount}}</span> possible material{{#unless (eq selectedCount 1)}}s{{/unless}}</small></div>
            <label class="cc-pool-chance"><span>Pool Chance %</span><input type="number" min="0" max="100" step="1" name="slot.chance" value="{{chance}}"></label>
          </div>
          <div class="cc-pool-selector cc-popover-field">
            <button type="button" class="cc-pool-selector-trigger" data-cc-popover-trigger data-cc-popover-target="cc-harvest-pool-popover-{{@index}}" aria-expanded="false">
              <i class="fa-solid fa-list-check"></i><span data-pool-summary>{{selectionSummary}}</span><i class="fa-solid fa-chevron-down"></i>
            </button>
            <div id="cc-harvest-pool-popover-{{@index}}" class="cc-select-popover cc-pool-options" data-cc-popover-panel data-popover-min-width="420" popover="auto">
              {{#each options}}
              <label class="cc-pool-option">
                <input type="checkbox" data-pool-material value="{{value}}" data-material-name="{{name}}" {{#if selected}}checked{{/if}}>
                <img src="{{img}}" alt="">
                <span><strong>{{name}}</strong><small class="cc-rarity {{rarity}}">{{rarityLabel}}</small></span>
              </label>
              {{else}}
              <div class="cc-empty-row">No curated materials exist for this rarity and creature type.</div>
              {{/each}}
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      <p class="cc-note"><i class="fa-solid fa-dice"></i> Example: Common 65% with four checked materials rolls the Common pool once; on success, each checked material has an equal 25% chance inside that pool.</p>
    </section>

    <section class="cc-form-card cc-essence-card">
      <div class="cc-card-heading"><div><span class="cc-kicker">Automatic Magical Harvest</span><h3>Essence Pool</h3></div><small>Separate from the four rarity pools and from Pinpoint Overrides.</small></div>
      {{#if essenceEnabled}}
        {{#if essenceHasSpecific}}
        <div class="cc-essence-distribution">
          <span><strong>{{profile.essenceSlot.arcaneChance}}%</strong><small>Arcane Essence</small></span>
          <span><strong>{{profile.essenceSlot.specificChance}}%</strong><small>Specific Essence</small></span>
        </div>
        <div class="cc-anatomy-tags cc-essence-tags">
          {{#each essenceAffinities}}<span>{{label}} · weight {{weight}}</span>{{/each}}
        </div>
        {{else}}
        <div class="cc-essence-distribution">
          <span><strong>{{profile.essenceSlot.arcaneChance}}%</strong><small>Arcane Essence</small></span>
          <span><strong>{{profile.essenceSlot.emptyChance}}%</strong><small>No Essence</small></span>
        </div>
        {{/if}}
        <details>
          <summary>Why this Essence profile?</summary>
          <ul>{{#each essenceReasons}}<li>{{this}}</li>{{else}}<li>No additional Essence inference notes.</li>{{/each}}</ul>
        </details>
      {{else}}
        <div class="cc-empty-row">This profile predates Essence analysis. Reanalyze the source Actor to enable Slot 5.</div>
      {{/if}}
    </section>

    <section class="cc-form-card">
      <div class="cc-card-heading"><div><span class="cc-kicker">Quest / Boss Materials</span><h3>Pinpoint Overrides</h3></div><small>Extra rolls. They are extra rolls and never consume a rarity-pool result.</small></div>
      <div class="cc-pinpoint-list">
        {{#each profile.pinpointOverrides}}
        <div class="cc-profile-slot cc-pinpoint-row" data-pinpoint-index="{{@index}}">
          <div class="cc-slot-label"><strong>Pinpoint {{position}}</strong><small>Explicit GM override</small></div>
          <label class="cc-slot-material"><span>Material</span><select data-material-select>
            {{#each options}}<option value="{{value}}" data-rarity="{{rarity}}" data-rarity-label="{{rarityLabel}}" data-chance="{{chance}}" data-quantity="{{quantity}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select></label>
          <label><span>Chance %</span><input type="number" min="0" max="100" step="1" name="pinpoint.chance" value="{{chance}}"></label>
          <label><span>Quantity</span><input type="text" name="pinpoint.quantity" value="{{quantity}}"></label>
          <span class="cc-rarity {{rarity}}" data-row-rarity>{{rarityLabel}}</span>
          <button type="button" class="cc-icon-button danger" data-action="remove-pinpoint" data-index="{{@index}}" data-tooltip="Remove Pinpoint Override"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{else}}
        <div class="cc-empty-row">No Pinpoint Overrides. Use these for unique boss/quest materials or guaranteed special drops.</div>
        {{/each}}
      </div>
      <button type="button" class="cc-secondary-action" data-action="add-pinpoint"><i class="fa-solid fa-plus"></i> Add Pinpoint Override</button>
    </section>
  </div>

  <footer class="cc-footer cc-profile-editor-footer">
    <span class="cc-note"><i class="fa-solid fa-shield-halved"></i> Source Actor remains read-only.</span>
    <button type="button" class="cc-primary-action" data-action="save-profile"><i class="fa-solid fa-floppy-disk"></i> Save Harvest Profile</button>
  </footer>
</section>
