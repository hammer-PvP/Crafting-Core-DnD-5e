<section class="cc-shell">
  <aside class="cc-sidebar">
    <header class="cc-app-header">
      <i class="fa-solid fa-hammer"></i>
      <div>
        <span class="cc-kicker">GM Tool</span>
        <h1>Crafting Core</h1>
        <p>Author, test, then publish</p>
      </div>
    </header>

    <button type="button" class="cc-new-recipe" data-action="new-recipe"><i class="fa-solid fa-plus"></i> New Recipe Draft</button>
    <div class="cc-sidebar-tools">
      <button type="button" class="cc-materials-launch" data-action="open-material-catalog"><i class="fa-solid fa-boxes-stacked"></i><span>Materials</span></button>
      <button type="button" class="cc-materials-launch cc-generator-launch" data-action="open-material-generator"><i class="fa-solid fa-dice-d20"></i><span>Generate</span></button>
      <button type="button" class="cc-materials-launch cc-scanner-launch" data-action="open-creature-scanner"><i class="fa-solid fa-magnifying-glass"></i><span>Scanner</span></button>
      <button type="button" class="cc-materials-launch" data-action="open-learn-sources"><i class="fa-solid fa-book"></i><span>Learn Sources</span></button>
    </div>

    <div class="cc-sidebar-section-label"><span>Recipes</span><small>{{recipeCount}}</small></div>
    <nav class="cc-recipe-list">
      {{#each recipes}}
      <button type="button" class="cc-recipe-nav {{#if selected}}active{{/if}}" data-recipe-id="{{id}}">
        <img src="{{img}}" alt="">
        <span><strong>{{name}}</strong><small>{{#if published}}Published · {{sourceType}}{{else}}Draft{{/if}} · {{craftingTime}} sec</small></span>
      </button>
      {{else}}
      <div class="cc-empty-sidebar"><i class="fa-solid fa-scroll"></i><span>No Recipe Builder drafts.</span></div>
      {{/each}}
    </nav>
  </aside>

  <main class="cc-main">
    <div class="cc-content">
      <header class="cc-section-header">
        <div>
          <span class="cc-kicker">Recipe Builder · {{#if published}}Published Draft{{else}}Draft{{/if}}</span>
          <h2>{{draft.name}}</h2>
          <p>The Builder is a GM workbench. Publish the finished Knowledge Source to the private Compendium, then this draft may be deleted safely.</p>
        </div>
        <img class="cc-recipe-image" src="{{draft.img}}" alt="">
      </header>

      {{#if published}}
      <div class="cc-publication-banner"><i class="fa-solid fa-circle-check"></i><div><strong>Published to Learn Sources</strong><small>The published Item contains a full recipe snapshot. Deleting this Builder draft will not break it or Characters who learned it.</small></div></div>
      {{/if}}

      <section class="cc-form-card">
        <h3>Recipe</h3>
        <div class="cc-grid two">
          <label><span>Name</span><input type="text" name="name" value="{{draft.name}}"></label>
          <label><span>Crafting Time (seconds)</span><input type="number" min="0" step="1" name="craftingTime" value="{{draft.craftingTime}}"></label>
        </div>
        <label class="cc-file-field"><span>Recipe Image</span><span><input type="text" name="img" value="{{draft.img}}"><button type="button" data-action="browse-image" data-target="img"><i class="fa-solid fa-folder-open"></i></button></span></label>
        <label class="cc-description-field"><span>Additional Description (optional)</span><textarea name="description" rows="4" placeholder="Optional lore, instructions, flavor, or crafting notes for this recipe.">{{draft.description}}</textarea><small>This text can be revealed to players independently through Player Visibility.</small></label>
      </section>

      <section class="cc-form-card cc-crafting-resolution-card">
        <div class="cc-card-heading"><div><span class="cc-kicker">Crafting Resolution</span><h3>Proficiency, Check & Failure Risk</h3></div><small>Optional rules layered on top of the existing recipe. Legacy recipes without these settings continue to craft automatically.</small></div>

        <div class="cc-resolution-section">
          <div class="cc-resolution-heading"><strong>Relevant Proficiency</strong><small>Choose a Skill, a Tool, or both. These determine access and/or automatic success according to the policies below.</small></div>
          <div class="cc-grid two cc-resolution-proficiencies">
            <label><span>Proficiency 1</span><select name="proficiency1">
              <option value="" {{#if (eq craftingResolutionOptions.proficiency1 "")}}selected{{/if}}>None</option>
              <optgroup label="Skills">{{#each craftingResolutionOptions.skillOptions}}<option value="{{value}}" {{#if (eq value ../craftingResolutionOptions.proficiency1)}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>
              <optgroup label="Tools">{{#each craftingResolutionOptions.toolOptions}}<option value="{{value}}" {{#if (eq value ../craftingResolutionOptions.proficiency1)}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>
            </select></label>
            <label><span>Proficiency 2 (optional)</span><select name="proficiency2">
              <option value="" {{#if (eq craftingResolutionOptions.proficiency2 "")}}selected{{/if}}>None</option>
              <optgroup label="Skills">{{#each craftingResolutionOptions.skillOptions}}<option value="{{value}}" {{#if (eq value ../craftingResolutionOptions.proficiency2)}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>
              <optgroup label="Tools">{{#each craftingResolutionOptions.toolOptions}}<option value="{{value}}" {{#if (eq value ../craftingResolutionOptions.proficiency2)}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>
            </select></label>
          </div>
          <div class="cc-grid three cc-resolution-policy-grid">
            <label><span>If two are selected</span><select name="proficiencyMatch">
              <option value="any" {{#if (eq draft.craftingResolution.proficiencyMatch "any")}}selected{{/if}}>Any one qualifies</option>
              <option value="all" {{#if (eq draft.craftingResolution.proficiencyMatch "all")}}selected{{/if}}>Both are required</option>
            </select></label>
            <label><span>Who can attempt</span><select name="attemptPolicy">
              <option value="anyone" {{#if (eq draft.craftingResolution.attemptPolicy "anyone")}}selected{{/if}}>Anyone</option>
              <option value="requiresProficiency" {{#if (eq draft.craftingResolution.attemptPolicy "requiresProficiency")}}selected{{/if}}>Requires relevant proficiency</option>
            </select></label>
            <label><span>If proficient</span><select name="proficientPolicy">
              <option value="rollNormally" {{#if (eq draft.craftingResolution.proficientPolicy "rollNormally")}}selected{{/if}}>Roll normally</option>
              <option value="automaticSuccess" {{#if (eq draft.craftingResolution.proficientPolicy "automaticSuccess")}}selected{{/if}}>Automatic success</option>
            </select></label>
          </div>
        </div>

        <div class="cc-resolution-section">
          <div class="cc-resolution-heading"><strong>Crafting Check</strong><small>The selected native D&D5e roll is made by the crafting player. The active GM validates the roll and commits the transaction.</small></div>
          <label class="cc-resolution-toggle"><input type="checkbox" name="requireCraftingCheck" data-resolution-rerender {{#if draft.craftingResolution.check.required}}checked{{/if}}><span><strong>Require a Crafting Check</strong><small>When disabled, an eligible crafter succeeds automatically.</small></span></label>
          {{#if draft.craftingResolution.check.required}}
          <div class="cc-grid two cc-resolution-check-grid">
            <label><span>Check</span><select name="craftingCheck">
              <optgroup label="Ability Checks">{{#each craftingResolutionOptions.abilityOptions}}<option value="{{value}}" {{#if (eq value ../craftingResolutionOptions.checkValue)}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>
              <optgroup label="Skills">{{#each craftingResolutionOptions.skillOptions}}<option value="{{value}}" {{#if (eq value ../craftingResolutionOptions.checkValue)}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>
              <optgroup label="Tools">{{#each craftingResolutionOptions.toolOptions}}<option value="{{value}}" {{#if (eq value ../craftingResolutionOptions.checkValue)}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>
              <optgroup label="Saving Throws">{{#each craftingResolutionOptions.saveOptions}}<option value="{{value}}" {{#if (eq value ../craftingResolutionOptions.checkValue)}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>
            </select></label>
            <label><span>Difficulty Class (DC)</span><input type="number" min="1" max="40" step="1" name="craftingDC" value="{{draft.craftingResolution.check.dc}}"></label>
          </div>

          <div class="cc-resolution-failure">
            <label class="cc-resolution-toggle"><input type="checkbox" name="loseMaterialsOnFailure" data-resolution-rerender {{#if draft.craftingResolution.failure.loseMaterials}}checked{{/if}}><span><strong>Lose materials on failure</strong><small>If the Crafting Check fails, consume the configured percentage of every required ingredient.</small></span></label>
            {{#if draft.craftingResolution.failure.loseMaterials}}
            <label class="cc-loss-slider"><span>Materials Lost on Failure <output data-failure-loss-output>{{draft.craftingResolution.failure.lossPercent}}%</output></span><input type="range" min="0" max="100" step="5" name="failureLossPercent" value="{{draft.craftingResolution.failure.lossPercent}}"></label>
            {{/if}}
          </div>
          {{/if}}
        </div>
      </section>

      <section class="cc-form-card cc-player-visibility-card">
        <div class="cc-card-heading"><div><span class="cc-kicker">Player Visibility</span><h3>What the Player Can See</h3></div><small>Hidden information remains stored and enforced by Crafting Core. These controls affect the Character Crafting tab and published Knowledge Source.</small></div>
        <div class="cc-visibility-grid">
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.output" {{#if draft.playerVisibility.output}}checked{{/if}}><span><strong>Output</strong><small>Reveal the crafted Item.</small></span></label>
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.ingredients" {{#if draft.playerVisibility.ingredients}}checked{{/if}}><span><strong>Ingredients</strong><small>Reveal required Item names.</small></span></label>
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.ingredientQuantities" {{#if draft.playerVisibility.ingredientQuantities}}checked{{/if}}><span><strong>Ingredient Quantities</strong><small>Reveal required and available amounts when ingredients are visible.</small></span></label>
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.proficiencies" {{#if draft.playerVisibility.proficiencies}}checked{{/if}}><span><strong>Relevant Proficiencies</strong><small>Reveal Skill/Tool requirements.</small></span></label>
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.attemptPolicy" {{#if draft.playerVisibility.attemptPolicy}}checked{{/if}}><span><strong>Who Can Attempt</strong><small>Reveal whether proficiency is required.</small></span></label>
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.craftingCheck" {{#if draft.playerVisibility.craftingCheck}}checked{{/if}}><span><strong>Crafting Check</strong><small>Reveal the configured roll type.</small></span></label>
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.craftingDC" {{#if draft.playerVisibility.craftingDC}}checked{{/if}}><span><strong>Crafting DC</strong><small>Reveal the target DC with the check.</small></span></label>
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.failure" {{#if draft.playerVisibility.failure}}checked{{/if}}><span><strong>Failure Consequence</strong><small>Reveal whether materials can be lost.</small></span></label>
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.failurePercent" {{#if draft.playerVisibility.failurePercent}}checked{{/if}}><span><strong>Failure Percentage</strong><small>Reveal the exact material-loss percentage.</small></span></label>
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.craftingTime" {{#if draft.playerVisibility.craftingTime}}checked{{/if}}><span><strong>Crafting Time</strong><small>Reveal the current crafting duration.</small></span></label>
          <label class="cc-visibility-toggle"><input type="checkbox" name="visibility.description" {{#if draft.playerVisibility.description}}checked{{/if}}><span><strong>Additional Description</strong><small>Reveal the optional GM-written description.</small></span></label>
        </div>
      </section>

      <section class="cc-form-card">
        <div class="cc-card-heading"><div><span class="cc-kicker">Requirements</span><h3>Items Consumed</h3></div><small>Any D&D5e Item can be an input. Materials from Crafting Core — Materials are only the organized automatic source.</small></div>
        <div class="cc-drop-zone" data-drop-kind="ingredient"><i class="fa-solid fa-arrow-down-to-line"></i><strong>Drop required Items here</strong></div>
        <div class="cc-item-rows">
          {{#each draft.ingredients}}
          <div class="cc-item-row">
            <img src="{{img}}" alt="">
            <div class="cc-item-name"><strong>{{name}}</strong><small>{{type}}</small></div>
            <label><span>Qty</span><input type="number" min="1" step="1" value="{{quantity}}" data-ingredient-quantity="{{@index}}"></label>
            <button type="button" class="cc-icon-button danger" data-action="remove-ingredient" data-index="{{@index}}" aria-label="Remove"><i class="fa-solid fa-trash"></i></button>
          </div>
          {{else}}
          <div class="cc-empty-row">No required Items yet.</div>
          {{/each}}
        </div>
      </section>

      <section class="cc-form-card">
        <div class="cc-card-heading"><div><span class="cc-kicker">Output</span><h3>Crafted Item</h3></div><small>The complete Item snapshot is reproduced when a Character crafts it, including Item Creator Activities, Effects and flags.</small></div>
        {{#if draft.result}}
        <div class="cc-result-card">
          <img src="{{draft.result.img}}" alt="">
          <div><strong>{{draft.result.name}}</strong><small>{{draft.result.type}}</small></div>
          <label><span>Qty</span><input type="number" min="1" step="1" name="resultQuantity" value="{{draft.result.quantity}}"></label>
          <button type="button" class="cc-icon-button danger" data-action="clear-result"><i class="fa-solid fa-xmark"></i></button>
        </div>
        {{else}}
        <div class="cc-drop-zone result" data-drop-kind="result"><i class="fa-solid fa-box-open"></i><strong>Drop the final Item here</strong></div>
        {{/if}}
      </section>

      <section class="cc-form-card">
        <div class="cc-card-heading"><div><span class="cc-kicker">Published Knowledge Source</span><h3>Recipe / Formula / Blueprint / Manual</h3></div><small>GM-only library source. Players see it only after the GM distributes a copy through an Actor, loot, chest, vendor or Supplier.</small></div>
        <div class="cc-grid two">
          <label><span>Source Type</span><select name="knowledgeLabel"><option value="Recipe" {{#if (eq draft.knowledge.label "Recipe")}}selected{{/if}}>Recipe</option><option value="Blueprint" {{#if (eq draft.knowledge.label "Blueprint")}}selected{{/if}}>Blueprint</option><option value="Formula" {{#if (eq draft.knowledge.label "Formula")}}selected{{/if}}>Formula</option><option value="Manual" {{#if (eq draft.knowledge.label "Manual")}}selected{{/if}}>Manual</option></select></label>
          <label><span>Custom Item Name (optional)</span><input type="text" name="knowledgeName" value="{{draft.knowledge.name}}" placeholder="Recipe — {{draft.name}}"></label>
        </div>
        <label class="cc-file-field"><span>Knowledge Source Image</span><span><input type="text" name="knowledgeImg" value="{{draft.knowledge.img}}"><button type="button" data-action="browse-image" data-target="knowledgeImg"><i class="fa-solid fa-folder-open"></i></button></span></label>
        <div class="cc-learning-access">
          <label><span>Learning Access</span><select name="learningAccess">
            <option value="followCraftingEligibility" {{#if (eq draft.learning.access "followCraftingEligibility")}}selected{{/if}}>Follow Crafting Eligibility</option>
            <option value="anyone" {{#if (eq draft.learning.access "anyone")}}selected{{/if}}>Anyone Can Learn</option>
          </select></label>
          <small><strong>Follow Crafting Eligibility</strong> prevents a Character from learning when the Recipe requires proficiencies they do not satisfy. A rejected attempt does not consume the Knowledge Source.</small>
        </div>
        <div class="cc-knowledge-economy">
          <span><strong>Rarity</strong>{{outputRarity}}</span>
          <span><strong>Knowledge Price</strong>{{knowledgePrice}} gp</span>
          <small>Rarity always comes from the crafted output. Price follows the D&D5e 5.3.3 magic crafting cost progression; Legendary = 100,000 gp.</small>
        </div>
        {{#if editingExisting}}
        <button type="button" class="cc-primary-action cc-wide" data-action="publish-recipe"><i class="fa-solid fa-upload"></i> {{#if published}}Update Published Source{{else}}Publish to Private Compendium{{/if}}</button>
        {{else}}
        <p class="cc-note"><i class="fa-solid fa-circle-info"></i> Save the draft before publishing its Knowledge Source.</p>
        {{/if}}
      </section>
    </div>

    <footer class="cc-footer">
      {{#if editingExisting}}<button type="button" class="cc-danger-action" data-action="delete-recipe"><i class="fa-solid fa-trash"></i> Delete Builder Draft</button>{{else}}<span></span>{{/if}}
      <button type="button" class="cc-primary-action" data-action="save-recipe"><i class="fa-solid fa-floppy-disk"></i> Save Draft</button>
    </footer>
  </main>
</section>
