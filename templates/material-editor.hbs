<section class="cc-material-editor-shell">
  <header class="cc-material-editor-head">
    <div class="cc-material-editor-preview"><img src="{{material.img}}" alt=""></div>
    <div>
      <span class="cc-kicker">{{#if builtIn}}Built-in Curated Material{{else}}Custom Registered Material{{/if}}</span>
      <h2>{{material.name}}</h2>
      <small>ID: {{material.id}}</small>
    </div>
  </header>

  <div class="cc-material-editor-body">
    <div class="cc-grid two">
      <label><span>Name</span><input type="text" name="name" value="{{material.name}}"></label>
      <label><span>Rarity</span><select name="rarity">{{#each rarityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    </div>

    <label class="cc-file-field"><span>Icon</span><span><input type="text" name="img" value="{{material.img}}"><button type="button" data-action="browse-material-image"><i class="fa-solid fa-folder-open"></i></button></span></label>

    <div class="cc-grid three">
      <label><span>Family</span><select name="family">{{#each familyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label><span>Nature</span><input type="text" name="nature" value="{{material.nature}}" placeholder="monstrosity / flora / trade"></label>
      <label><span>Category</span><input type="text" name="category" value="{{material.category}}" placeholder="undead / roots / food"></label>
    </div>

    <div class="cc-grid three">
      <label><span>Default Drop Chance %</span><input type="number" name="chance" min="0" max="100" step="0.1" value="{{material.chance}}"></label>
      <label><span>Quantity Formula</span><input type="text" name="quantity" value="{{material.quantity}}" placeholder="1 / 1d4"></label>
      <label><span>Value (gp)</span><input type="number" name="price" min="0" step="1" value="{{material.price}}"></label>
    </div>

    <label><span>Tags</span><input type="text" name="tags" value="{{material.tags}}" placeholder="food, metal, arcane"></label>
    <label><span>Anatomy Requirements</span><input type="text" name="requires" value="{{material.requires}}" placeholder="flesh, bone, feather"></label>
    <label><span>Biomes</span><input type="text" name="biomes" value="{{material.biomes}}" placeholder="forest, swamp, cave"></label>

    <p class="cc-note"><i class="fa-solid fa-shield-halved"></i> The Materials Compendium remains GM-only. Editing catalog metadata changes future generation rules; it does not expose this material to players.</p>
  </div>

  <footer class="cc-footer">
    {{#if builtIn}}<button type="button" class="cc-secondary-action" data-action="reset-material"><i class="fa-solid fa-rotate-left"></i> Reset Curated Default</button>{{else}}<span></span>{{/if}}
    <button type="button" class="cc-primary-action" data-action="save-material"><i class="fa-solid fa-floppy-disk"></i> Save Material</button>
  </footer>
</section>
