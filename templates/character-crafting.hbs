<section class="tab {{tab.cssClass}} crafting-core-tab" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="cc-sheet-panel">
    {{#if craftingCore.busy}}
      <div class="cc-sheet-job">
        <div class="cc-sheet-product"><i class="fa-solid fa-hammer"></i></div>
        <div class="cc-progress-track" aria-label="Crafting progress"><span data-crafting-progress style="width: {{craftingCore.job.progress}}%"></span></div>
      </div>
    {{else if craftingCore.hasRecipes}}
      <header class="cc-sheet-header">
        <label><span>Recipe</span>
          <select data-action="select-recipe">
            {{#each craftingCore.recipes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{craftCount}}× {{name}}</option>{{/each}}
          </select>
        </label>
      </header>

      {{#with craftingCore.selectedRecipe}}
      <article class="cc-sheet-recipe">
        <div class="cc-sheet-result">
          <img src="{{result.img}}" alt="">
          <div><strong>{{name}}</strong><small>{{result.name}}{{#if result.quantity}} ×{{result.quantity}}{{/if}}</small></div>
        </div>
        <div class="cc-sheet-ingredients">
          {{#each ingredientRows}}
          <div class="cc-sheet-ingredient {{#unless sufficient}}missing{{/unless}}">
            <img src="{{img}}" alt="">
            <span>{{name}}</span>
            <strong>{{available}} / {{quantity}}</strong>
            <i class="fa-solid {{#if sufficient}}fa-check{{else}}fa-xmark{{/if}}"></i>
          </div>
          {{/each}}
        </div>

        <div class="cc-sheet-resolution {{#unless resolution.eligible}}blocked{{/unless}}">
          {{#if resolution.proficiencyRows.length}}
          <div class="cc-sheet-resolution-row">
            <i class="fa-solid fa-screwdriver-wrench"></i>
            <span>Relevant proficiency</span>
            <strong>
              {{#each resolution.proficiencyRows}}{{label}}{{#unless @last}}{{#if (eq ../resolution.proficiencyMatch "all")}} + {{else}} or {{/if}}{{/unless}}{{/each}}
            </strong>
          </div>
          {{/if}}
          {{#if resolution.check.required}}
          <div class="cc-sheet-resolution-row">
            <i class="fa-solid fa-dice-d20"></i>
            <span>Crafting Check</span>
            <strong>{{#if resolution.automaticSuccess}}Automatic Success{{else}}{{resolution.checkLabel}} · DC {{resolution.check.dc}}{{/if}}</strong>
          </div>
          {{/if}}
          {{#if resolution.rollRequired}}
          <div class="cc-sheet-resolution-row">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Failure</span>
            <strong>{{#if resolution.failure.loseMaterials}}{{resolution.failure.lossPercent}}% materials lost{{else}}No materials lost{{/if}}</strong>
          </div>
          {{/if}}
          {{#unless resolution.eligible}}<p class="cc-sheet-resolution-block"><i class="fa-solid fa-lock"></i> {{resolution.blockReason}}</p>{{/unless}}
        </div>

        <button type="button" class="cc-sheet-craft" data-action="craft" data-recipe-id="{{id}}" {{#unless canCraft}}disabled{{/unless}}><i class="fa-solid {{#if resolution.rollRequired}}fa-dice-d20{{else}}fa-hammer{{/if}}"></i> {{#if resolution.rollRequired}}Attempt Craft{{else}}Craft{{/if}}</button>
      </article>
      {{/with}}
    {{else}}
      <div class="cc-sheet-empty">
        <i class="fa-solid fa-scroll"></i>
        <strong>No recipes learned</strong>
        <p>This character has not learned any Crafting Core recipes yet.</p>
      </div>
    {{/if}}
  </div>
</section>
