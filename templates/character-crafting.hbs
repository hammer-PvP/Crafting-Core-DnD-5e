<section class="tab {{tab.cssClass}} crafting-core-tab" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{#if craftingCore.hasRecipes}}
  <div class="cc-profession-layout">
    <aside class="cc-profession-recipes">
      <div class="cc-profession-title"><i class="fa-solid fa-hammer"></i><div><strong>Crafting</strong><small>Known Recipes</small></div></div>
      <div class="cc-profession-recipe-list">
        {{#each craftingCore.recipes}}
        <button type="button" class="cc-profession-recipe {{#if selected}}selected{{/if}} {{#if active}}active-project{{/if}}" data-action="select-recipe" data-recipe-id="{{id}}">
          <img src="{{img}}" alt="">
          <span class="cc-profession-recipe-name"><strong>{{name}}</strong><small>{{modeLabel}}{{#if active}} · Active Project{{/if}}</small></span>
          {{#if playerVisibility.craftCount}}<span class="cc-profession-count">{{craftCount}}×</span>{{else}}<span></span>{{/if}}
        </button>
        {{/each}}
      </div>
    </aside>

    <main class="cc-profession-detail">
      {{#if craftingCore.timedJob}}
      <div class="cc-active-timed-banner">
        <span><i class="fa-solid fa-hourglass-half"></i> Crafting in progress: <strong>{{craftingCore.timedJob.recipeName}}</strong></span>
        <div class="cc-progress-track"><span data-crafting-progress style="width: {{craftingCore.timedJob.progress}}%"></span></div>
      </div>
      {{/if}}

      {{#with craftingCore.selectedRecipe}}
      <header class="cc-profession-detail-header">
        <img src="{{img}}" alt="">
        <div><span class="cc-kicker">{{#if (eq craftingMode "project")}}Crafting Project{{else}}Timed Recipe{{/if}}</span><h2>{{name}}</h2>{{#if ../craftingCore.selectedIsActiveProject}}<small class="cc-active-project-label"><i class="fa-solid fa-hammer"></i> Active Project</small>{{/if}}</div>
        <button type="button" class="cc-recipe-unlearn" data-action="unlearn-recipe" data-tooltip="Forget this Recipe"><i class="fa-solid fa-book"></i> Unlearn</button>
      </header>

      {{#if playerVisibility.description}}{{#if description}}<section class="cc-profession-block"><h3>Description</h3><p class="cc-sheet-description">{{description}}</p></section>{{/if}}{{/if}}

      {{#if ../craftingCore.selectedIsActiveProject}}
        {{#with ../craftingCore.activeProject}}
        <section class="cc-profession-block cc-project-status-block">
          <div class="cc-profession-block-heading"><div><span class="cc-kicker">Project Status</span><h3>{{stateLabel}}</h3></div><strong>{{#if visibility.projectProgress}}{{completedWork}} / {{requiredWork}}{{else}}In Progress{{/if}}</strong></div>
          {{#if visibility.projectProgress}}<div class="cc-project-progress-track"><span style="width: {{progressPercent}}%"></span></div>{{/if}}
          {{#if visibility.craftingTime}}<div class="cc-inline-fact"><span>Work Cadence</span><strong>{{cadenceLabel}}</strong></div>{{/if}}
        </section>

        {{#if visibility.ingredients}}
        <section class="cc-profession-block"><h3>Reserved Materials</h3><div class="cc-sheet-ingredients cc-reserved-materials">
          {{#each reservedMaterials}}<div class="cc-sheet-ingredient"><img src="{{img}}" alt=""><span>{{name}}</span><strong>{{#if ../visibility.ingredientQuantities}}×{{quantity}}{{else}}Reserved{{/if}}</strong><i class="fa-solid fa-lock"></i></div>{{/each}}
        </div></section>
        {{/if}}

        {{#if visibility.progressCheck}}{{#if config.progressCheck.required}}
        <section class="cc-profession-block"><h3>Progress Check</h3>
          <div class="cc-sheet-resolution-row"><i class="fa-solid fa-dice-d20"></i><span>Check</span><strong>{{progressCheckLabel}}{{#if visibility.progressDC}} · DC {{config.progressCheck.dc}}{{/if}}</strong></div>
          <div class="cc-sheet-resolution-row"><i class="fa-solid fa-route"></i><span>When</span><strong>{{#if (eq config.progressCheck.timing "midpoint")}}Midpoint Only{{else}}Every Work Period{{/if}}</strong></div>
          {{#if visibility.progressFailure}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-triangle-exclamation"></i><span>Failure</span><strong>{{progressFailureLabel}}</strong></div>{{/if}}
        </section>
        {{/if}}{{/if}}

        {{#if visibility.extraEffort}}{{#if config.extraEffort.enabled}}
        <section class="cc-profession-block cc-extra-effort-block"><h3>Extra Effort</h3>
          {{#if visibility.extraEffortCheck}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-person-running"></i><span>Check</span><strong>{{extraEffortCheckLabel}}{{#if visibility.extraEffortDC}} · DC {{config.extraEffort.dc}}{{/if}}</strong></div>{{/if}}
          <div class="cc-sheet-resolution-row"><i class="fa-solid fa-forward"></i><span>Success</span><strong>+{{config.extraEffort.progressGain}} Work Progress</strong></div>
          {{#if visibility.extraEffortFailure}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-triangle-exclamation"></i><span>Failure</span><strong>{{extraEffortFailureLabel}}</strong></div>{{/if}}
        </section>
        {{/if}}{{/if}}

        {{#if visibility.craftingCheck}}{{#if resolution.check.required}}
        <section class="cc-profession-block"><h3>Final Crafting Check</h3>
          <div class="cc-sheet-resolution-row"><i class="fa-solid fa-dice-d20"></i><span>Check</span><strong>{{#if finalPolicy.automaticSuccess}}Automatic Success{{else}}{{finalCheckLabel}}{{#if visibility.craftingDC}} · DC {{resolution.check.dc}}{{/if}}{{/if}}</strong></div>
          {{#if visibility.failure}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-triangle-exclamation"></i><span>Failure</span><strong>{{finalFailureLabel}}</strong></div>{{/if}}
        </section>
        {{/if}}{{/if}}

        <div class="cc-project-actions">
          {{#if (eq phase "working")}}
            {{#if workAvailable}}<button type="button" class="cc-sheet-craft" data-action="work-project"><i class="fa-solid fa-hammer"></i> Work on Project</button>
            {{else}}<button type="button" class="cc-sheet-craft" disabled><i class="fa-solid fa-moon"></i> {{#if visibility.craftingTime}}Waiting for {{cadenceLabel}}{{else}}Work Not Available Yet{{/if}}</button>{{/if}}
          {{else}}
            {{#if (eq phase "readyFinal")}}
              {{#if finalAvailable}}<button type="button" class="cc-sheet-craft" data-action="final-project"><i class="fa-solid {{#if manualFinalRequired}}fa-dice-d20{{else}}fa-hammer{{/if}}"></i> {{#if manualFinalRequired}}{{#if visibility.craftingCheck}}Attempt Final Check{{else}}Complete Project{{/if}}{{else}}Complete Project{{/if}}</button>
              {{else}}<button type="button" class="cc-sheet-craft" disabled><i class="fa-solid fa-moon"></i> {{#if visibility.craftingTime}}Waiting for {{cadenceLabel}}{{else}}Not Available Yet{{/if}}</button>{{/if}}
            {{/if}}
          {{/if}}
          {{#if (eq phase "working")}}{{#if config.extraEffort.enabled}}
            {{#if extraEffortAvailable}}
              <button type="button" class="cc-sheet-craft cc-extra-effort-action" data-action="extra-effort"><i class="fa-solid fa-person-running"></i> Extra Effort</button>
            {{else}}
              <button type="button" class="cc-sheet-craft cc-extra-effort-action" disabled><i class="fa-solid fa-person-running"></i> {{extraEffortStateLabel}}</button>
            {{/if}}
          {{/if}}{{/if}}
          <button type="button" class="cc-project-cancel" data-action="cancel-project"><i class="fa-solid fa-ban"></i> Cancel Project</button>
        </div>
        {{/with}}
      {{else}}
        {{#if playerVisibility.ingredients}}
        <section class="cc-profession-block"><h3>Ingredients</h3><div class="cc-sheet-ingredients">
          {{#each ingredientRows}}
          <div class="cc-sheet-ingredient {{#unless sufficient}}missing{{/unless}} {{#unless ../playerVisibility.ingredientQuantities}}quantities-hidden{{/unless}}"><img src="{{img}}" alt=""><span>{{name}}</span><strong>{{#if ../playerVisibility.ingredientQuantities}}{{available}} / {{quantity}}{{else}}{{#if sufficient}}Available{{else}}Missing{{/if}}{{/if}}</strong><i class="fa-solid {{#if sufficient}}fa-check{{else}}fa-xmark{{/if}}"></i></div>
          {{/each}}
        </div></section>
        {{/if}}

        <section class="cc-profession-block"><h3>Requirements</h3>
          {{#if playerVisibility.output}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-box-open"></i><span>Output</span><strong>{{result.name}}{{#if result.quantity}} ×{{result.quantity}}{{/if}}</strong></div>{{/if}}
          {{#if playerVisibility.craftingTime}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-clock"></i><span>{{#if (eq craftingMode "project")}}Project Time{{else}}Crafting Time{{/if}}</span><strong>{{#if (eq craftingMode "project")}}{{project.requiredWork}} Work Period{{#unless (eq project.requiredWork 1)}}s{{/unless}} · {{projectDisplay.cadenceLabel}}{{else}}{{craftingTime}} sec{{/if}}</strong></div>{{/if}}
          {{#if playerVisibility.proficiencies}}{{#if resolution.proficiencyRows.length}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-screwdriver-wrench"></i><span>Relevant Proficiency</span><strong>{{#each resolution.proficiencyRows}}{{label}}{{#unless @last}}{{#if (eq ../resolution.proficiencyMatch "all")}} + {{else}} or {{/if}}{{/unless}}{{/each}}</strong></div>{{/if}}{{/if}}
          {{#if playerVisibility.attemptPolicy}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-user-check"></i><span>Who Can Attempt</span><strong>{{#if (eq resolution.attemptPolicy "requiresProficiency")}}Requires relevant proficiency{{else}}Anyone{{/if}}</strong></div>{{/if}}
          {{#unless resolution.eligible}}<p class="cc-sheet-resolution-block"><i class="fa-solid fa-lock"></i> {{resolution.publicBlockReason}}</p>{{/unless}}
        </section>

        {{#if (eq craftingMode "project")}}
          {{#if playerVisibility.progressCheck}}{{#if project.progressCheck.required}}<section class="cc-profession-block"><h3>Progress Checks</h3><div class="cc-sheet-resolution-row"><i class="fa-solid fa-dice-d20"></i><span>Check</span><strong>{{projectDisplay.progressCheckLabel}}{{#if playerVisibility.progressDC}} · DC {{project.progressCheck.dc}}{{/if}}</strong></div><div class="cc-sheet-resolution-row"><i class="fa-solid fa-route"></i><span>When</span><strong>{{#if (eq project.progressCheck.timing "midpoint")}}Midpoint Only{{else}}Every Work Period{{/if}}</strong></div>{{#if playerVisibility.progressFailure}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-triangle-exclamation"></i><span>Failure</span><strong>{{projectDisplay.progressFailureLabel}}</strong></div>{{/if}}</section>{{/if}}{{/if}}
        {{/if}}

        {{#if playerVisibility.extraEffort}}{{#if project.extraEffort.enabled}}<section class="cc-profession-block cc-extra-effort-block"><h3>Extra Effort</h3>{{#if playerVisibility.extraEffortCheck}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-person-running"></i><span>Check</span><strong>{{projectDisplay.extraEffortCheckLabel}}{{#if playerVisibility.extraEffortDC}} · DC {{project.extraEffort.dc}}{{/if}}</strong></div>{{/if}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-forward"></i><span>Success</span><strong>+{{project.extraEffort.progressGain}} Work Progress</strong></div>{{#if playerVisibility.extraEffortFailure}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-triangle-exclamation"></i><span>Failure</span><strong>{{projectDisplay.extraEffortFailureLabel}}</strong></div>{{/if}}</section>{{/if}}{{/if}}

        {{#if playerVisibility.craftingCheck}}{{#if resolution.check.required}}<section class="cc-profession-block"><h3>Final Crafting Check</h3><div class="cc-sheet-resolution-row"><i class="fa-solid fa-dice-d20"></i><span>Check</span><strong>{{#if resolution.automaticSuccess}}Automatic Success{{else}}{{resolution.checkLabel}}{{#if playerVisibility.craftingDC}} · DC {{resolution.check.dc}}{{/if}}{{/if}}</strong></div>{{#if playerVisibility.failure}}<div class="cc-sheet-resolution-row"><i class="fa-solid fa-triangle-exclamation"></i><span>Failure</span><strong>{{projectDisplay.finalFailureLabel}}</strong></div>{{/if}}</section>{{/if}}{{/if}}

        {{#if ../craftingCore.selectedBlockedByOtherProject}}
          <div class="cc-project-lock-note"><i class="fa-solid fa-lock"></i><span>Finish or cancel <strong>{{../craftingCore.activeProject.recipeName}}</strong> before starting another Project. You can still inspect this Recipe for planning.</span></div>
        {{/if}}

        {{#if (eq craftingMode "project")}}
          <button type="button" class="cc-sheet-craft" data-action="start-project" {{#unless ../craftingCore.selectedCanStart}}disabled{{/unless}}><i class="fa-solid fa-hammer"></i> Start Project</button>
        {{else}}
          <button type="button" class="cc-sheet-craft" data-action="craft" {{#unless ../craftingCore.selectedCanStart}}disabled{{/unless}}><i class="fa-solid {{#if resolution.rollRequired}}fa-dice-d20{{else}}fa-hammer{{/if}}"></i> {{#if resolution.rollRequired}}Attempt Craft{{else}}Craft{{/if}}</button>
        {{/if}}
      {{/if}}
      {{/with}}
    </main>
  </div>
  {{else}}
  <div class="cc-sheet-empty"><i class="fa-solid fa-scroll"></i><strong>No recipes learned</strong><p>This character has not learned any Crafting Core recipes yet.</p></div>
  {{/if}}
</section>
